{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Six",
    "scopeName": "source.six",
    "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#directives" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#functions" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.six",
                    "match": "//.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.six",
                    "match": "\\b(if|else|for|try|end|ret|six|use|as)\\b"
                },
                {
                    "name": "storage.type.six",
                    "match": "\\b(v|fn)\\b"
                },
                {
                    "name": "support.function.six",
                    "match": "\\b(put|get|ptr|leak|report)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.six",
                    "match": "\\b(i32|i64|BigInt|ptr|str|bool)\\b"
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.other.directive.six",
                    "match": "#\\w+"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.six",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.six",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.six",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.six",
                    "match": "(\\+|\\-|\\*|/|=|&|@|\\.\\.|<|>|!|\\^|\\|)"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.six"
                        }
                    }
                }
            ]
        }
    }
}